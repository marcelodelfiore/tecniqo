<% content_for :title, application_name %>

<div class="mx-auto max-w-3xl py-16 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-blue-600"><%= t("home.eyebrow") %></p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
    <%= application_name %>
  </h1>
  <p class="mx-auto mt-5 max-w-2xl text-lg text-gray-600">
    <%= t("home.description") %>
  </p>

  <div class="mt-8 flex justify-center gap-3">
    <% if authenticated? %>
      <%= link_to t("home.open_dashboard"), dashboard_path, class: "rounded-xl bg-blue-600 px-5 py-3 text-sm font-medium text-white hover:bg-blue-700" %>
    <% else %>
      <%= link_to t("home.sign_in"), new_session_path, class: "rounded-xl bg-blue-600 px-5 py-3 text-sm font-medium text-white hover:bg-blue-700" %>
    <% end %>
  </div>
</div>
