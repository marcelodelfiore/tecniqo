<% content_for :title, t("clarifications.new.title") %>
<div class="mx-auto max-w-2xl space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("engineering_reviews.index.title"), path: engineering_reviews_path }, { label: @review.work_order.public_identifier, path: engineering_review_path(@review) }, { label: t("clarifications.new.title") } ] %>
  <%= render "shared/page_header", title: t("clarifications.new.title"), subtitle: t("clarifications.new.subtitle") %>
  <section class="rounded-2xl border border-blue-200 bg-blue-50 p-5"><p class="text-xs font-semibold uppercase tracking-wide text-blue-700"><%= clarification_target_title(@target) %></p><p class="mt-2 text-sm leading-6 text-blue-950"><%= clarification_target_summary(@target) %></p></section>
  <%= form_with model: @clarification, url: engineering_review_clarification_requests_path(@review, execution_id: @execution.id, target_type: @target.class.name, target_id: @target.id), class: "space-y-5 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm" do |form| %>
    <%= render "shared/form_errors", object: @clarification %>
    <div><%= form.label :recipient_membership_id, t("clarifications.recipient"), class: "block text-sm font-medium text-gray-700" %><%= form.collection_select :recipient_membership_id, @recipients, :id, ->(membership) { membership.user.email }, {}, required: true, class: "mt-1 min-h-11 w-full rounded-xl border border-gray-300 bg-white px-3" %></div>
    <div><%= form.label :question, t("clarifications.question"), class: "block text-sm font-medium text-gray-700" %><%= form.text_area :question, rows: 5, required: true, autofocus: true, class: "mt-1 w-full rounded-xl border border-gray-300 px-3 py-2" %></div>
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><%= link_to t("actions.cancel"), engineering_review_path(@review), class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-gray-300 px-4" %><%= form.submit t("clarifications.send"), class: "min-h-11 rounded-xl bg-amber-600 px-5 font-semibold text-white" %></div>
  <% end %>
</div>
