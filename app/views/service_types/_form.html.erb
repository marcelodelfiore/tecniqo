<%= form_with model: service_type, class: "space-y-6" do |form| %>
  <%= render "shared/form_errors", object: service_type %>
  <div><%= form.label :name, t("labels.name"), class: "mb-1 block text-sm font-medium text-gray-700" %><%= form.text_field :name, required: true, autofocus: true, class: "block min-h-11 w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %></div>
  <div><%= form.label :description, t("labels.description"), class: "mb-1 block text-sm font-medium text-gray-700" %><%= form.text_area :description, rows: 4, class: "block w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm" %></div>
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <%= link_to t("actions.cancel"), service_types_path, class: "inline-flex min-h-11 items-center justify-center rounded-xl px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
    <%= form.submit class: "inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white" %>
  </div>
<% end %>
