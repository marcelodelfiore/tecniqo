<article class="rounded-xl border border-gray-200 bg-white p-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div><p class="text-xs font-semibold uppercase tracking-wide text-gray-500"><%= title %></p><div class="mt-1 text-sm leading-6 text-gray-900"><%= body %></div></div>
    <% if policy(@review).request_clarification? %>
      <%= link_to t("clarifications.request"), clarification_request_path_for(@review, execution, record), class: "inline-flex min-h-10 items-center rounded-lg border border-amber-300 bg-amber-50 px-3 text-xs font-semibold text-amber-900" %>
    <% end %>
  </div>
  <% if record.respond_to?(:evidence_references) && record.evidence_references.any? %>
    <div class="mt-3 flex flex-wrap gap-2">
      <% record.evidence_references.each do |reference| %>
        <div><%= link_to reference.evidence.original_filename, original_work_order_execution_evidence_path(@work_order, execution, reference.evidence), class: "inline-flex min-h-10 items-center rounded-lg bg-blue-50 px-3 text-xs font-medium text-blue-800" %><p class="mt-1 text-xs text-emerald-700"><%= t("engineering_reviews.integrity_recorded") %> · SHA-256</p></div>
      <% end %>
    </div>
  <% end %>
</article>
