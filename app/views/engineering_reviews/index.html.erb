<% content_for :title, t("engineering_reviews.index.title") %>
<div class="space-y-6">
  <%= render "shared/page_header", title: t("engineering_reviews.index.title"), subtitle: t("engineering_reviews.index.subtitle") %>

  <% if @reviews.any? %>
    <div class="grid gap-4 xl:grid-cols-2">
      <% @reviews.each do |review| %>
        <% work_order = review.work_order %>
        <%= link_to engineering_review_path(review), class: "block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-blue-300" do %>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div><p class="font-semibold text-blue-700"><%= work_order.public_identifier %></p><h2 class="mt-1 text-lg font-semibold text-gray-950"><%= work_order.customer.name %></h2><p class="text-sm text-gray-600"><%= work_order.site.name %><% if work_order.asset %> · <%= work_order.asset.name %><% end %></p></div>
            <span class="rounded-full px-3 py-1 text-xs font-semibold <%= review_state_classes(review.state) %>"><%= t("engineering_reviews.states.#{review.state}") %></span>
          </div>
          <p class="mt-4 text-sm font-medium text-gray-800"><%= work_order.service_type.name %></p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-600">
            <span><%= t("engineering_reviews.visit_count", count: work_order.executions.size) %></span>
            <% if review.reviewer %><span><%= t("engineering_reviews.reviewer", name: review.reviewer.email) %></span><% end %>
            <span><%= t("engineering_reviews.updated", date: l(review.updated_at, format: :long)) %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: t("engineering_reviews.index.empty_title"), message: t("engineering_reviews.index.empty_message") %>
  <% end %>
</div>
