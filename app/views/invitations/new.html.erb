<% content_for :title, "Invite member" %>

<div class="mx-auto max-w-2xl space-y-6">
  <%= render "shared/page_header",
        title: "Invite member",
        subtitle: "Invite someone to #{Current.organization.name}." %>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "shared/form_errors", object: @invitation %>

    <%= form_with model: @invitation, url: invitations_path, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :email, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "email",
              class: "block w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <fieldset>
        <legend class="text-sm font-medium text-gray-700">Roles</legend>
        <p class="mt-1 text-sm text-gray-500">Select at least one responsibility.</p>

        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <% MembershipRole::ROLES.each do |role| %>
            <label class="flex min-h-11 items-center gap-3 rounded-xl border border-gray-200 px-4 py-3 text-sm text-gray-700">
              <%= check_box_tag "invitation[roles][]", role, @invitation.roles.include?(role),
                    id: "invitation_role_#{role}",
                    class: "size-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
              <span><%= role.humanize %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Cancel", invitations_path,
              class: "inline-flex min-h-11 items-center justify-center rounded-xl px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2" %>
        <%= form.submit "Send invitation",
              class: "inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>
