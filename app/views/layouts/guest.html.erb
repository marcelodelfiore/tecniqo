<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : application_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= application_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <%= render 'shared/flash' %>

    <div class="flex min-h-screen flex-col">
      <header class="px-4 py-6">
        <div class="mx-auto max-w-md text-center">
          <p class="text-sm font-semibold text-gray-900"><%= application_name %></p>
          <p class="text-xs text-gray-500">Reusable Rails starter</p>
        </div>
      </header>

      <main class="flex flex-1 items-center justify-center px-4 pb-10">
        <div class="w-full max-w-md">
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <%= yield %>
          </div>
        </div>
      </main>

      <footer class="px-4 pb-6">
        <div class="mx-auto max-w-md text-center text-xs text-gray-500">
          <p><%= application_name %></p>
        </div>
      </footer>
    </div>
  </body>
</html>
