<aside class="hidden w-72 shrink-0 border-r border-gray-200 bg-white lg:block">
  <div class="flex h-full flex-col">
    <div class="border-b border-gray-200 px-6 py-5">
      <h2 class="text-lg font-semibold text-gray-900"><%= application_name %></h2>
      <p class="mt-1 text-sm text-gray-500">Reusable Rails starter</p>
    </div>

    <nav class="flex-1 space-y-1 px-4 py-4">
      <%= link_to "Home", root_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" %>

      <% if authenticated? %>
        <%= link_to "Dashboard", dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
      <% end %>
    </nav>
  </div>
</aside>
