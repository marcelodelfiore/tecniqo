<% content_for :title, @asset.name %>
<div class="space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("customers.index.title"), path: customers_path }, { label: @customer.name, path: customer_path(@customer) }, { label: @site.name, path: customer_site_path(@customer, @site) }, { label: @asset.name } ] %>
  <%= render "shared/page_header", title: @asset.name, subtitle: t("assets.show.context", customer: @customer.name, site: @site.name),
        action: (link_to(t("actions.edit"), edit_customer_site_asset_path(@customer, @site, @asset), class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50") if policy(@asset).update?) %>
  <dl class="grid gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-3 sm:p-6">
    <% { asset_type: t("asset_types.#{@asset.asset_type}"), tag: @asset.tag, manufacturer: @asset.manufacturer, model: @asset.model, serial_number: @asset.serial_number }.each do |label, value| %>
      <% if value.present? %><div class="min-w-0"><dt class="text-sm font-medium text-gray-500"><%= t("labels.#{label}") %></dt><dd class="mt-1 break-words text-sm text-gray-900"><%= value %></dd></div><% end %>
    <% end %>
  </dl>
</div>
