<% content_for :title, t("memberships.index.title") %>

<div class="space-y-6">
  <%= render "shared/page_header",
        title: t("memberships.index.title"),
        subtitle: t("memberships.index.subtitle", organization: Current.organization.name) %>

  <div class="space-y-3">
    <% @memberships.each do |membership| %>
      <article class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <p class="truncate font-medium text-gray-900"><%= membership.user.email %></p>
            <p class="mt-1 text-sm text-gray-600">
              <%= membership.membership_roles.map { |assignment| t("roles.#{assignment.role}") }.to_sentence %>
              · <%= membership.active? ? t("memberships.status.active") : t("memberships.status.inactive") %>
            </p>
          </div>

          <%= link_to t("actions.edit"), edit_membership_path(membership),
                class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
        </div>
      </article>
    <% end %>
  </div>
</div>
