<% content_for :title, t("my_work.title") %>
<div class="space-y-6">
  <%= render "shared/page_header", title: t("my_work.title"), subtitle: t("my_work.subtitle") %>
  <% if @clarifications.any? %>
    <section class="space-y-3" aria-labelledby="needs-information-title">
      <div><h2 id="needs-information-title" class="text-lg font-semibold text-gray-950"><%= t("clarifications.needs_information") %></h2><p class="mt-1 text-sm text-gray-600"><%= t("clarifications.technician_hint") %></p></div>
      <% @clarifications.each do |clarification| %>
        <% work_order = clarification.engineering_review.work_order %>
        <%= link_to clarification_request_path(clarification), class: "block rounded-2xl border-2 border-amber-200 bg-amber-50 p-5 shadow-sm" do %>
          <p class="font-semibold text-amber-900"><%= work_order.public_identifier %></p>
          <h3 class="mt-1 font-semibold text-gray-950"><%= work_order.asset&.name || work_order.site.name %></h3>
          <p class="mt-3 text-sm font-medium text-gray-800"><%= t("clarifications.question_from", name: clarification.requested_by.email) %></p>
          <p class="mt-1 text-sm leading-6 text-gray-700"><%= clarification.question %></p>
        <% end %>
      <% end %>
    </section>
  <% end %>
  <% if @executions.any? || @assigned_work_orders.any? %>
    <div class="space-y-4">
      <% @executions.each do |execution| %>
        <% work_order = execution.work_order %>
        <%= link_to work_order_execution_path(work_order, execution), class: "block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500" do %>
          <div class="flex items-start justify-between gap-3"><div><p class="font-semibold text-blue-700"><%= work_order.public_identifier %> · <%= t("executions.visit", number: execution.visit_number) %></p><h2 class="mt-1 text-lg font-semibold text-gray-900"><%= work_order.customer.name %></h2><p class="text-sm text-gray-600"><%= work_order.site.name %><% if work_order.asset %> · <%= work_order.asset.name %><% end %></p></div><span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= execution_state_classes(execution.current_state) %>"><%= t("execution_states.#{execution.current_state}") %></span></div>
          <p class="mt-4 text-sm font-medium text-gray-800"><%= work_order.service_type.name %></p>
          <p class="mt-3 text-sm text-gray-500"><%= execution.scheduled_start ? l(execution.scheduled_start, format: :long) : t("work_orders.index.unscheduled") %></p>
        <% end %>
      <% end %>
      <% @assigned_work_orders.each do |work_order| %>
        <%= link_to work_order_path(work_order), class: "block rounded-2xl border border-dashed border-gray-300 bg-white p-5" do %><p class="font-semibold text-blue-700"><%= work_order.public_identifier %></p><h2 class="mt-1 font-semibold"><%= work_order.customer.name %></h2><p class="mt-2 text-sm text-gray-600"><%= t("my_work.assigned_coordination") %></p><% end %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: t("my_work.empty_title"), message: t("my_work.empty_message") %>
  <% end %>
</div>
