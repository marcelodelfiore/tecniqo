<% if record.evidence_references.any? %>
  <div class="mt-3 flex flex-wrap gap-2">
    <% record.evidence_references.each do |reference| %>
      <%= link_to original_work_order_execution_evidence_path(@work_order, @execution, reference.evidence), class: "inline-flex min-h-10 items-center rounded-lg bg-blue-50 px-3 text-xs font-medium text-blue-800" do %>
        <%= t("evidence_reference_roles.#{reference.role}") %>: <%= reference.evidence.original_filename %>
      <% end %>
    <% end %>
  </div>
<% end %>
