<section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
  <div class="flex items-center justify-between gap-3">
    <div><h3 class="text-lg font-semibold text-gray-900"><%= title %></h3><p class="text-sm text-gray-500"><%= t("technical_records.count", count: records.size) %></p></div>
    <% candidate = @execution.public_send(association).new(organization: Current.organization) %>
    <% if policy(candidate).create? %>
      <%= link_to t("technical_records.add", record: singular_title), new_technical_record_path(@work_order, @execution, route_key), class: "inline-flex min-h-11 items-center rounded-xl bg-blue-700 px-4 text-sm font-semibold text-white" %>
    <% end %>
  </div>
  <% if records.any? %>
    <div class="mt-4 space-y-3">
      <% records.each do |record| %>
        <article class="rounded-xl border border-gray-200 p-4">
          <%= yield record %>
          <%= render "technical_records/evidence", record: record %>
          <% if policy(record).update? %>
            <div class="mt-3 flex items-center gap-4 border-t border-gray-100 pt-3 text-sm">
              <%= link_to t("actions.edit"), edit_technical_record_path(@work_order, @execution, record), class: "font-medium text-blue-700" %>
              <%= button_to t("actions.remove"), technical_record_form_path(@work_order, @execution, record), method: :delete, class: "font-medium text-red-700", data: { turbo_confirm: t("technical_records.confirm_remove") } %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-gray-500"><%= t("technical_records.empty") %></p>
  <% end %>
</section>
