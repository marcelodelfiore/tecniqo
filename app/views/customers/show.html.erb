<% content_for :title, @customer.name %>
<div class="space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("customers.index.title"), path: customers_path }, { label: @customer.name } ] %>
  <%= render "shared/page_header", title: @customer.name, subtitle: @customer.legal_name,
        action: (link_to(t("actions.edit"), edit_customer_path(@customer), class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50") if policy(@customer).update?) %>

  <% contextual_work_order = Current.organization.work_orders.new(customer: @customer) %>
  <% if policy(contextual_work_order).create? %>
    <%= link_to t("work_orders.context.from_customer"), new_work_order_path(customer_id: @customer.id), class: "inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white" %>
  <% end %>

  <% if [@customer.business_identifier, @customer.email, @customer.phone, @customer.notes].any?(&:present?) %>
    <dl class="grid gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:grid-cols-2 sm:p-6">
      <% { business_identifier: @customer.business_identifier, email: @customer.email, phone: @customer.phone, notes: @customer.notes }.each do |label, value| %>
        <% if value.present? %><div class="min-w-0"><dt class="text-sm font-medium text-gray-500"><%= t("labels.#{label}") %></dt><dd class="mt-1 break-words text-sm text-gray-900"><%= simple_format(value, class: "m-0") %></dd></div><% end %>
      <% end %>
    </dl>
  <% end %>

  <section class="space-y-4">
    <%= render "shared/page_header", title: t("customers.show.sites"), subtitle: t("customers.show.sites_subtitle"),
          action: (link_to(t("customers.show.add_site"), new_customer_site_path(@customer), class: "inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white") if policy(@customer.sites.new(organization: Current.organization)).create?) %>
    <% if @sites.any? %>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @sites.each do |site| %>
          <%= link_to customer_site_path(@customer, site), class: "block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm hover:border-blue-300" do %>
            <h3 class="font-semibold text-gray-900"><%= site.name %></h3>
            <% if site.address.present? %><p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= site.address %></p><% end %>
            <p class="mt-4 text-sm font-medium text-gray-700"><%= t("customers.show.asset_count", count: site.assets_count) %></p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: t("customers.show.empty_sites_title"), message: t("customers.show.empty_sites_message") %>
    <% end %>
  </section>
</div>
