<% content_for :title, @work_order.public_identifier %>
<div class="space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("work_orders.index.title"), path: work_orders_path }, { label: @work_order.public_identifier } ] %>
  <%= render "shared/page_header", title: @work_order.public_identifier, subtitle: @work_order.service_type.name,
        action: (link_to(t("actions.edit"), edit_work_order_path(@work_order), class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700") if policy(@work_order).update?) %>

  <div class="grid gap-4 lg:grid-cols-3">
    <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm lg:col-span-2 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900"><%= t("work_orders.show.requested_work") %></h2>
      <div class="mt-3 text-sm leading-6 text-gray-700"><%= simple_format(@work_order.requested_work, class: "m-0") %></div>
      <dl class="mt-6 grid gap-4 border-t border-gray-100 pt-5 sm:grid-cols-2">
        <% { customer: @work_order.customer.name, site: @work_order.site.name, asset: @work_order.asset&.name, service_type: @work_order.service_type.name, priority: t("priorities.#{@work_order.priority}"), scheduled_start: (@work_order.scheduled_start ? l(@work_order.scheduled_start, format: :long) : t("work_orders.index.unscheduled")) }.each do |label, value| %>
          <% if value.present? %><div><dt class="text-sm font-medium text-gray-500"><%= t("labels.#{label}") %></dt><dd class="mt-1 text-sm font-medium text-gray-900"><%= value %></dd></div><% end %>
        <% end %>
      </dl>
    </section>

    <aside class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900"><%= t("work_orders.show.assignment") %></h2>
      <% if @work_order.current_assignment %>
        <p class="mt-3 break-all font-medium text-gray-900"><%= @work_order.current_assignment.assignee.email %></p>
        <p class="mt-1 text-sm text-gray-500"><%= t("work_orders.show.assigned_at", date: l(@work_order.current_assignment.assigned_at, format: :long)) %></p>
      <% else %>
        <p class="mt-3 text-sm text-gray-600"><%= t("work_orders.index.unassigned") %></p>
      <% end %>

      <% assignment = @work_order.assignments.new(organization: Current.organization) %>
      <% if policy(assignment).create? %>
        <%= form_with url: work_order_assignment_path(@work_order), class: "mt-5 space-y-3" do |form| %>
          <%= form.label :membership_id, t("work_orders.show.reassign_to"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.collection_select :membership_id, @technicians, :id, ->(membership) { membership.user.email }, { include_blank: t("work_orders.form.select_technician") }, required: true, class: "block min-h-11 w-full rounded-xl border border-gray-300 bg-white px-3 py-2.5 text-sm" %>
          <%= form.submit t("work_orders.show.assign"), class: "inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white" %>
        <% end %>
      <% end %>
    </aside>
  </div>

  <% if @assignments.any? %>
    <section class="space-y-3">
      <h2 class="text-lg font-semibold text-gray-900"><%= t("work_orders.show.assignment_history") %></h2>
      <% @assignments.each do |assignment_record| %>
        <article class="rounded-xl border border-gray-200 bg-white p-4 text-sm">
          <p class="break-all font-medium text-gray-900"><%= assignment_record.assignee.email %></p>
          <p class="mt-1 text-gray-600"><%= t("work_orders.show.assignment_period", start: l(assignment_record.assigned_at, format: :long), finish: assignment_record.ended_at ? l(assignment_record.ended_at, format: :long) : t("work_orders.show.current"), actor: assignment_record.assigned_by.email) %></p>
        </article>
      <% end %>
    </section>
  <% end %>
</div>
