<% content_for :title, t("work_orders.edit.title") %>
<div class="mx-auto max-w-3xl space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("work_orders.index.title"), path: work_orders_path }, { label: @work_order.public_identifier, path: work_order_path(@work_order) }, { label: t("actions.edit") } ] %>
  <%= render "shared/page_header", title: t("work_orders.edit.title"), subtitle: @work_order.public_identifier %>
  <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6"><%= render "form", work_order: @work_order %></div>
</div>
