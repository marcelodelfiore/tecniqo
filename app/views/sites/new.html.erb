<% content_for :title, t("sites.new.title") %>
<div class="mx-auto max-w-2xl space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("customers.index.title"), path: customers_path }, { label: @customer.name, path: customer_path(@customer) }, { label: t("sites.new.title") } ] %>
  <%= render "shared/page_header", title: t("sites.new.title"), subtitle: t("sites.new.subtitle", customer: @customer.name) %>
  <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6"><%= render "form", customer: @customer, site: @site %></div>
</div>
