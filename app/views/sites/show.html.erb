<% content_for :title, @site.name %>
<div class="space-y-6">
  <%= render "shared/breadcrumbs", items: [ { label: t("customers.index.title"), path: customers_path }, { label: @customer.name, path: customer_path(@customer) }, { label: @site.name } ] %>
  <%= render "shared/page_header", title: @site.name, subtitle: @customer.name,
        action: (link_to(t("actions.edit"), edit_customer_site_path(@customer, @site), class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50") if policy(@site).update?) %>

  <% if [@site.address, @site.contact_name, @site.phone, @site.notes].any?(&:present?) %>
    <dl class="grid gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:grid-cols-2 sm:p-6">
      <% { address: @site.address, contact_name: @site.contact_name, phone: @site.phone, notes: @site.notes }.each do |label, value| %>
        <% if value.present? %><div class="min-w-0"><dt class="text-sm font-medium text-gray-500"><%= t("labels.#{label}") %></dt><dd class="mt-1 break-words text-sm text-gray-900"><%= simple_format(value, class: "m-0") %></dd></div><% end %>
      <% end %>
    </dl>
  <% end %>

  <section class="space-y-4">
    <%= render "shared/page_header", title: t("sites.show.assets"), subtitle: t("sites.show.assets_subtitle"),
          action: (link_to(t("sites.show.add_asset"), new_customer_site_asset_path(@customer, @site), class: "inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white") if policy(@site.assets.new(organization: Current.organization)).create?) %>
    <% if @assets.any? %>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @assets.each do |asset| %>
          <%= link_to customer_site_asset_path(@customer, @site, asset), class: "block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm hover:border-blue-300" do %>
            <h3 class="font-semibold text-gray-900"><%= asset.name %></h3>
            <p class="mt-1 text-sm text-gray-600"><%= t("asset_types.#{asset.asset_type}") %></p>
            <% if asset.tag.present? %><p class="mt-3 text-sm font-medium text-gray-700"><%= t("sites.show.tag", tag: asset.tag) %></p><% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: t("sites.show.empty_assets_title"), message: t("sites.show.empty_assets_message") %>
    <% end %>
  </section>
</div>
